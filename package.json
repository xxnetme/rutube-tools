{
  "name": "rutube-tools",
  "version": "1.9.0",
  "private": true,
  "description": "Расширение для RuTube: кадры, MP4, звук M4A. Зависимостей в рантайме нет; package.json нужен только для тестов и линтера.",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "npx --yes eslint@10 src tests",
    "typecheck": "npx --yes -p typescript@7.0.2 tsc -p jsconfig.json",
    "build": "python3 build.py",
    "test:e2e": "python3 tests/e2e/browser_e2e.py --browser all",
    "bench:opfs": "python3 tests/opfs/opfs_bench.py --browser all --size-mib 64"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "jsdom": "29.1.1",
    "mediabunny": "1.65.2",
    "playwright": "1.65.0"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
