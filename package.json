{
  "name": "rutube-tools",
  "version": "1.8.0",
  "private": true,
  "description": "Расширение для RuTube: кадры, MP4, звук M4A. Зависимостей в рантайме нет; package.json нужен только для тестов и линтера.",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "npx --yes eslint@10 src tests",
    "typecheck": "npx --yes -p typescript@7.0.2 tsc -p jsconfig.json",
    "build": "python3 build.py"
  },
  "devDependencies": {
    "eslint-plugin-no-unsanitized": "4.1.5"
  }
}
